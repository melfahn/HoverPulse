<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HoverPulse</RootNamespace>
    <AssemblyName>HoverPulse</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon> -->
    <Version>0.1.0</Version>
    <Company>QuadSoft, Inc.</Company>
    <Product>Hover Click</Product>
    <Description>Hover Click — hands-free dwell clicking for Windows</Description>
    <Copyright>Copyright (c) QuadSoft, Inc. Licensed under GPL-3.0.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.*" />
    <PackageReference Include="System.Text.Json" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HoverPulse.Tests" />
  </ItemGroup>

</Project>
